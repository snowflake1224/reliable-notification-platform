NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://nplat:nplat@localhost:5432/nplat
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000

REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-jwt-secret-change-me
API_KEY_PEPPER=dev-api-key-pepper-change-me
WEBHOOK_SECRET=dev-webhook-secret-change-me

PROVIDER_BASE_URL=http://localhost:4000
PROVIDER_TIMEOUT_MS=2000
ALLOW_TEST_FAILURES=true

API_RATE_LIMIT_PER_SEC=50
EMAIL_RATE_LIMIT_PER_SEC=20
SMS_RATE_LIMIT_PER_SEC=10
PUSH_RATE_LIMIT_PER_SEC=50

OUTBOX_POLL_MS=250
OUTBOX_BATCH_SIZE=50
OUTBOX_CLAIM_TIMEOUT_MS=30000
MAX_OUTBOX_BACKLOG=5000

QUEUE_STREAM=nplat:jobs
QUEUE_DLQ_STREAM=nplat:jobs:dlq
QUEUE_GROUP=workers
VISIBILITY_TIMEOUT_MS=30000
WORKER_CONCURRENCY=8
MAX_ATTEMPTS=5

SCHEDULER_POLL_MS=500
SCHEDULER_BATCH_SIZE=100

MAILHOG_SMTP_HOST=localhost
MAILHOG_SMTP_PORT=1025
