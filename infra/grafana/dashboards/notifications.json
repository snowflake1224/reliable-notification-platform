{
  "annotations": { "list": [] },
  "title": "Notifications",
  "uid": "nplat-overview",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Accepted /s",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(nplat_notifications_accepted_total[1m]))", "legendFormat": "accepted" }]
    },
    {
      "type": "timeseries",
      "title": "Delivered /s",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(nplat_deliveries_total{result=\"delivered\"}[1m]))", "legendFormat": "delivered" }]
    },
    {
      "type": "timeseries",
      "title": "Retrying /s",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(nplat_deliveries_total{result=\"retry\"}[1m]))", "legendFormat": "retry scheduled" }]
    },
    {
      "type": "stat",
      "title": "Dead (since process start)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(nplat_deliveries_total{result=\"dead\"})", "legendFormat": "dead" }]
    }
  ]
}
